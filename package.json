  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "author": "Valmia Solutions s.r.o.",
  "homepage": "https://lettio.eu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lettio-eu/mcp.git"
  },
  "bugs": {
