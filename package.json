{
  "name": "@lettio/mcp",
  "version": "0.1.2",
  "mcpName": "eu.lettio/mcp",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCP server for Lettio — let your AI agent read, search and send email from a private, EU-hosted mailbox (JMAP).",
  "type": "module",
  "bin": {
